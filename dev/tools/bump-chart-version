"""Increments the patch version in helm/Chart.yaml.

This is the remediation for a dev/tools/verify-chart-version failure. Bump the
minor or major version by hand instead when the chart change warrants it.
"""

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
CHART_FILE = REPO_ROOT / "helm" / "Chart.yaml"

VERSION_RE = re.compile(r"^(version:\s*)(\d+)\.(\d+)\.(\d+)[ \t]*$", re.MULTILINE)


def main():
    if not CHART_FILE.exists():
        print(f"ERROR: {CHART_FILE} does not exist.", file=sys.stderr)
        return 1

    text = CHART_FILE.read_text()
    match = VERSION_RE.search(text)
    if not match:
        print(
            "ERROR: could not find a 'version: X.Y.Z' line in "
            f"{CHART_FILE.relative_to(REPO_ROOT)}.",
            file=sys.stderr,
        )
        return 1

    prefix, major, minor, patch = match.groups()
    old = f"{major}.{minor}.{patch}"
    new = f"{major}.{minor}.{int(patch) + 1}"

    CHART_FILE.write_text(
        text[: match.start()] + prefix + new + text[match.end():]
    )
    print(f"Bumped chart version: {old} -> {new}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
