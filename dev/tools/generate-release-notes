import argparse
import json
import os
import re
import subprocess
import sys

REPO = "kubernetes-sigs/agent-sandbox"

# Exclude noisy test, generated, and lock files from code diffs sent to Gemini.
# Every commit still includes its full `git show --stat` file list.
EXCLUDED_DIFF_PATHSPECS = (
    ":!*_test.go",
    ":!*_test.py",
    ":!*/test_*.py",
    ":!*.test.ts",
    ":!*/__tests__/*",
    ":!clients/k8s/*",
    ":!*zz_generated*",
    ":!olm/*",
    ":!*package-lock.json",
    ":!docs/*_reference.md",
)

MAX_DIFF_CHARS_PER_COMMIT = 20_000
MAX_TOTAL_DIFF_CHARS = 450_000


def select_previous_release_tag(releases, current_tag):
    """Selects the previous stable release tag, excluding current_tag."""
    for rel in releases:
        tag = rel.get("tagName")
        if rel.get("isLatest") and tag and tag != current_tag:
            return tag

    for rel in releases:
        tag = rel.get("tagName")
        if (
            tag
            and tag != current_tag
            and not rel.get("isDraft")
            and not rel.get("isPrerelease")
        ):
            return tag

    return None


def get_previous_release_tag(current_tag):
    """Queries the previous stable release tag directly from GitHub via gh."""
    try:
        # Assumption: Currently only patching of the latest minor release happens.
        # TODO: Support patching older minor releases
        raw = subprocess.run(
            [
                "gh",
                "release",
                "list",
                "--limit",
                "20",
                "--json",
                "tagName,isLatest,isDraft,isPrerelease",
                "--repo",
                REPO,
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout.strip()
        releases = json.loads(raw) if raw else []
        prev_tag = select_previous_release_tag(releases, current_tag)
        if prev_tag:
            print(f"INFO: Found previous stable release on GitHub: {prev_tag}")
        return prev_tag
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"❌ Error: Failed to fetch releases via gh CLI: {e}")
        sys.exit(1)


def extract_pr_number(title):
    """Extracts the PR number from a commit title, or returns None."""
    patterns = (r"\(#(\d+)\)$", r"Merge pull request #(\d+)")
    for pattern in patterns:
        match = re.search(pattern, title)
        if match:
            return int(match.group(1))
    return None


def get_commits(prev_tag, current_tag):
    """Returns non-merge commits in range with sha, title, body, and PR number."""
    range_str = f"{prev_tag}..{current_tag}" if prev_tag else current_tag
    try:
        raw_log = subprocess.run(
            [
                "git",
                "log",
                "--no-merges",
                range_str,
                "--pretty=format:%x1e%H%n%s%n%b",
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout

        commits = []
        if raw_log:
            for chunk in raw_log.split("\x1e"):
                if not chunk.strip():
                    continue
                lines = chunk.splitlines()
                if len(lines) < 2:
                    continue
                sha = lines[0].strip()
                title = lines[1]
                body = "\n".join(lines[2:]).strip()
                commits.append(
                    {
                        "sha": sha,
                        "title": title,
                        "body": body,
                        "pr_number": extract_pr_number(title),
                    }
                )
        return commits
    except subprocess.CalledProcessError:
        return []


def get_pr_numbers(commits):
    """Extracts unique PR numbers from commits, preserving commit order."""
    seen = set()
    pr_numbers = []
    for commit in commits:
        pr = commit.get("pr_number")
        if pr is None:
            pr = extract_pr_number(commit["title"])
        if pr is not None and pr not in seen:
            seen.add(pr)
            pr_numbers.append(pr)
    return pr_numbers


def get_commit_files(sha):
    """Returns the list of file paths changed in a commit."""
    try:
        out = subprocess.run(
            ["git", "show", "--name-only", "--format=", sha],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout
        return [line.strip() for line in out.splitlines() if line.strip()]
    except subprocess.CalledProcessError:
        return []


def get_commit_stat(sha):
    """Returns the `git show --stat` summary for a commit."""
    try:
        return subprocess.run(
            ["git", "show", "--stat", "--format=", sha],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        return ""


def truncate_text(text, max_chars):
    """Truncates text on a newline boundary when it exceeds max_chars."""
    if max_chars <= 0:
        return ""
    if len(text) <= max_chars:
        return text
    omitted = len(text) - max_chars
    cut = text.rfind("\n", 0, max_chars)
    prefix = text[:cut] if cut > 0 else text[:max_chars]
    return f"{prefix}\n... [diff truncated, {omitted} chars omitted]"


def get_commit_diff(sha, max_chars=MAX_DIFF_CHARS_PER_COMMIT):
    """Returns the filtered code diff for a commit, capped at max_chars."""
    if max_chars <= 0:
        return ""
    try:
        diff = subprocess.run(
            [
                "git",
                "show",
                "--no-color",
                "--format=",
                "--unified=3",
                sha,
                "--",
                ".",
                *EXCLUDED_DIFF_PATHSPECS,
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout.strip()
        return truncate_text(diff, max_chars)
    except subprocess.CalledProcessError:
        return ""


def _is_doc_file(path):
    return (
        path.endswith(".md")
        or path.startswith("docs/")
        or path.startswith("site/content/")
    )


def _is_test_file(path):
    base = os.path.basename(path)
    return (
        path.startswith("test/")
        or "/__tests__/" in path
        or path.endswith("_test.go")
        or path.endswith("_test.py")
        or path.endswith(".test.ts")
        or (base.startswith("test_") and base.endswith(".py"))
    )


def _is_ci_or_tooling_file(path):
    return (
        path.startswith(".github/")
        or path.startswith("dev/ci/")
        or path.startswith("dev/tools/")
    )


def _is_dep_file(path):
    base = os.path.basename(path)
    return base in (
        "go.mod",
        "go.sum",
        "package.json",
        "package-lock.json",
        "requirements.txt",
        "pyproject.toml",
    )


def classify_commit_files(files, is_bot=False):
    """Classifies a commit's scope from its changed file paths."""
    if is_bot:
        return "bot-dependency-update"
    if not files:
        return "empty"
    if all(_is_doc_file(f) for f in files):
        return "docs-only"
    if all(_is_test_file(f) for f in files):
        return "tests-only"
    if all(_is_ci_or_tooling_file(f) for f in files):
        return "ci-or-tooling-only"
    if all(_is_dep_file(f) for f in files):
        return "deps-only"
    return "code-or-manifests"


def parse_helm_chart_version_change(diff_text):
    """Extracts (old_version, new_version) from a helm/Chart.yaml diff."""
    old_ver = None
    new_ver = None
    for line in diff_text.splitlines():
        if line.startswith("-") and not line.startswith("---"):
            match = re.match(r"^-\s*version:\s*(\S+)", line)
            if match:
                old_ver = match.group(1)
        elif line.startswith("+") and not line.startswith("+++"):
            match = re.match(r"^\+\s*version:\s*(\S+)", line)
            if match:
                new_ver = match.group(1)
    if old_ver and new_ver and old_ver != new_ver:
        return old_ver, new_ver
    return None


def collect_release_signals(prev_tag, current_tag, commits):
    """Computes deterministic release-level facts from git history."""
    signals = []
    crd_files = sorted(
        {
            os.path.basename(f)
            for c in commits
            for f in c.get("files", [])
            if f.startswith("k8s/crds/") or f.startswith("helm/crds/")
        }
    )
    if crd_files:
        signals.append(
            "CRD schema files changed (Helm users must apply updated CRDs manually): "
            + ", ".join(crd_files)
        )

    if prev_tag:
        try:
            chart_diff = subprocess.run(
                ["git", "diff", f"{prev_tag}..{current_tag}", "--", "helm/Chart.yaml"],
                check=True,
                text=True,
                stdout=subprocess.PIPE,
            ).stdout
            version_change = parse_helm_chart_version_change(chart_diff)
            if version_change:
                signals.append(
                    f"Helm chart version bumped in helm/Chart.yaml: {version_change[0]} -> {version_change[1]}"
                )
        except subprocess.CalledProcessError:
            pass

    return signals


def enrich_commits(commits, prs_data, max_total_diff_chars=MAX_TOTAL_DIFF_CHARS):
    """Attaches changed files, git stat, filtered diffs, and PR metadata to commits."""
    remaining_budget = max_total_diff_chars
    enriched = []
    for commit in commits:
        sha = commit["sha"]
        pr = commit.get("pr_number")
        pr_info = prs_data.get(pr, {}) if pr is not None else {}
        author = pr_info.get("author") or {}
        files = get_commit_files(sha)
        stat = get_commit_stat(sha)
        scope = classify_commit_files(files, is_bot=bool(author.get("is_bot")))

        diff = ""
        if scope not in ("bot-dependency-update", "tests-only", "empty"):
            commit_budget = min(MAX_DIFF_CHARS_PER_COMMIT, remaining_budget)
            if commit_budget > 0:
                diff = get_commit_diff(sha, max_chars=commit_budget)
                remaining_budget = max(0, remaining_budget - len(diff))

        labels = [l["name"] for l in pr_info.get("labels", [])]
        enriched.append(
            {
                **commit,
                "files": files,
                "stat": stat,
                "diff": diff,
                "scope": scope,
                "labels": labels,
                "pr_body": (pr_info.get("body") or "").strip(),
            }
        )
    return enriched


def fetch_prs_data(pr_numbers):
    """Fetches PR details (labels, body, author) once per PR to minimize API overhead."""
    prs_data = {}
    for pr in pr_numbers:
        try:
            out = subprocess.run(
                [
                    "gh",
                    "pr",
                    "view",
                    str(pr),
                    "--json",
                    "labels,body,author",
                    "--repo",
                    REPO,
                ],
                check=True,
                text=True,
                stdout=subprocess.PIPE,
            ).stdout
            prs_data[pr] = json.loads(out)
        except subprocess.CalledProcessError:
            print(f"⚠️ Warning: Failed to fetch PR #{pr} details.")
    return prs_data


def get_contributors(prs_data):
    """Extracts verified GitHub handles of all human PR authors.

    Bot authors are skipped: gh marks them with is_bot and reports logins such
    as "app/dependabot", which are not GitHub handles.
    """
    contributors = set()
    for data in prs_data.values():
        author = data.get("author") or {}
        if author.get("is_bot"):
            continue
        login = author.get("login")
        if login:
            contributors.add(f"@{login}")
    return sorted(list(contributors))


def get_breaking_changes(prs_data):
    """Extracts breaking changes from fetched PR data with action required label."""
    breaking_changes = []
    for pr, data in prs_data.items():
        labels = [l["name"] for l in data.get("labels", [])]
        if "release-note-action-required" in labels:
            body = data.get("body", "").strip()
            if body:
                breaking_changes.append(f"PR #{pr}: {body}")
    return breaking_changes


def get_pr_descriptions(prs_data):
    """Extracts PR descriptions from fetched PR data."""
    pr_descriptions = []
    for pr, data in prs_data.items():
        body = data.get("body", "").strip()
        if body:
            pr_descriptions.append(f"PR #{pr}: {body}")
    return pr_descriptions


def extract_github_footer(generated_notes, prev_tag, current_tag):
    """Extracts New Contributors and Full Changelog, dropping What's Changed."""
    sections = []

    if generated_notes:
        new_contrib_match = re.search(
            r"(?ms)^##\s+New Contributors\s*\n(.*?)(?=\n##\s+|\n\*\*Full Changelog\*\*:|\Z)",
            generated_notes,
        )
        if new_contrib_match:
            body = new_contrib_match.group(1).strip()
            if body:
                sections.append(f"### New Contributors\n{body}")

        changelog_match = re.search(
            r"(?m)^\*\*Full Changelog\*\*:.*$", generated_notes
        )
        if changelog_match:
            sections.append(changelog_match.group(0).strip())
        elif prev_tag:
            sections.append(
                f"**Full Changelog**: https://github.com/{REPO}/compare/{prev_tag}...{current_tag}"
            )
    elif prev_tag:
        sections.append(
            f"**Full Changelog**: https://github.com/{REPO}/compare/{prev_tag}...{current_tag}"
        )

    return "\n\n".join(sections)


def fetch_github_release_footer(prev_tag, current_tag):
    """Fetches GitHub's New Contributors and Full Changelog footer via gh api."""
    cmd = [
        "gh",
        "api",
        f"repos/{REPO}/releases/generate-notes",
        "-f",
        f"tag_name={current_tag}",
        "--jq",
        ".body",
    ]
    if prev_tag:
        cmd.extend(["-f", f"previous_tag_name={prev_tag}"])

    try:
        generated = subprocess.run(
            cmd,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout
        return extract_github_footer(generated, prev_tag, current_tag)
    except subprocess.CalledProcessError as e:
        print(f"⚠️ Warning: Failed to fetch GitHub release footer: {e}")
        return extract_github_footer("", prev_tag, current_tag)


def strip_markdown_fences(text):
    """Removes a surrounding ```markdown ... ``` fence if Gemini wrapped output."""
    stripped = text.strip()
    match = re.match(r"^```(?:markdown|md)?\s*\n(.*?)\n```\s*$", stripped, re.DOTALL)
    if match:
        return match.group(1).strip()
    return stripped


def format_commit_records(enriched_commits):
    """Formats enriched commits as grouped per-change records for the prompt."""
    blocks = []
    for commit in enriched_commits:
        pr = commit.get("pr_number")
        header = f"### Commit {commit['sha'][:8]}"
        if pr is not None:
            header += f" (PR #{pr})"
        header += f" — {commit['title']}"

        lines = [header, f"Scope classification: {commit['scope']}"]
        if commit["labels"]:
            lines.append("PR labels: " + ", ".join(commit["labels"]))
        if commit["body"]:
            lines.append("Commit message body:\n" + commit["body"])
        if commit["pr_body"]:
            lines.append("PR description:\n" + commit["pr_body"])
        if commit["stat"]:
            lines.append("Changed files (`git show --stat`):\n" + commit["stat"])
        if commit["diff"]:
            lines.append("Filtered code diff:\n```diff\n" + commit["diff"] + "\n```")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def build_prompt(
    enriched_commits,
    breaking_changes,
    contributors,
    tag,
    installation_notes,
    release_signals=None,
):
    """Builds the Gemini prompt grounded in per-commit diffs and release signals."""
    contributors_str = ", ".join(contributors)
    commit_records = format_commit_records(enriched_commits)
    signals_str = (
        "\n".join(f"- {s}" for s in release_signals)
        if release_signals
        else "(none detected)"
    )

    is_pre_release = bool(re.match(r"^v?\d+\.\d+\.\d+(?:\.)?rc\d+$", tag))
    pre_release_instruction = ""
    pre_release_example = ""
    if is_pre_release:
        pre_release_instruction = (
            "\n- Since this is a pre-release candidate, include a "
            "`### ⚠️ Pre-Release Notice` section immediately after the intro paragraph "
            "using GitHub alert syntax `> [!WARNING]`. State that it is a release "
            "candidate intended for testing/validation, not production, and summarize "
            "specific areas to test."
        )
        pre_release_example = """
### ⚠️ Pre-Release Notice
> [!WARNING]
> This is a Release Candidate (RC) intended for testing and validation, not production.
"""

    return f"""**Task:** Generate accurate, concise release notes for **Agent Sandbox {tag}** from the verified per-commit diffs, file stats, PR descriptions, and release signals below.

**Accuracy rules (highest priority):**
- **Trust the actual diff and `git show --stat` over commit messages and PR descriptions.** Contributors often change code during review without updating the commit message or PR body. Whenever a PR description disagrees with the diff (field names, defaults, touched files, scope, or capabilities), follow the diff.
- **Use exact exported names per language:**
  - Go SDK: PascalCase (`Suspend()`, `Files.Extract`, `Options.ShutdownPolicy`).
  - Python SDK: snake_case (`suspend()`, `files.extract()`), explicitly noting sync and async parity when both exist.
  - TypeScript SDK: camelCase (`suspend()`, `files.extract()`). The TypeScript SDK is async-only; never claim synchronous methods for TypeScript.
  - Never present unexported internal helpers as public API.
- **State exact scope and prerequisites:**
  - Name the specific example directory changed (for example `examples/openclaw-gvisor-sandbox`), never pluralize to all examples.
  - Distinguish documented snippets in `README.md` from actual manifest changes.
  - Distinguish `sandboxd` REST `/v1/files/...` changes from gRPC changes.
  - Do not claim isolation or security guarantees (such as "isolated") unless the diff actually enforces them (for example via a `NetworkPolicy` or authentication).
  - Note minimum server/runtime versions (e.g., `sandboxd` `{tag}+`, `sandbox-router` `v1.0.9+`), upgrade ordering, or manual CRD apply requirements for Helm users whenever relevant.
  - Do not inflate `docs-only`, `tests-only`, `ci-or-tooling-only`, or `bot-dependency-update` commits into runtime features. Omit routine test cleanups and bot dependency bumps from Highlights.
- **Check for Action Required items beyond labels:** Inspect both the `Breaking Changes` list and all diffs for breaking changes, changed defaults affecting existing deployments, removed exported symbols, or incompatible wire/error behavior. Only include `### ⚠️ Action Required` if real user action is needed on upgrade.
- **Include real PR numbers** (`(#123)`) from the input records. Never invent PR numbers.

**Style rules:**
- Write in plain, direct technical English using active voice. Avoid marketing phrasing ("major advancements", "seamless", "exciting new capabilities") and avoid em-dashes.
- Do not include a top-level `# 🚀 Announcing ...` heading (the script prepends it).
- Do not include `## What's Changed`, `### New Contributors`, or `**Full Changelog**` (the script appends `### New Contributors` and `**Full Changelog**` automatically).{pre_release_instruction}

**Required section order:**
1. Short intro paragraph announcing Agent Sandbox {tag} with a concrete summary of the main highlights.
2. `### ⚠️ Pre-Release Notice` (only if pre-release).
3. `### ⚠️ Action Required` (only if genuine upgrade actions exist).
4. `---` then `### Highlights`, grouped only under applicable headings from:
   - `#### Core & Extension Controllers`
   - `#### Sandbox Router`
   - `#### sandboxd`
   - `#### SDKs`
   - `#### Examples`
   - `#### Documentation & CI`
5. `---` then the exact `### Installation` block provided below.
6. `--------` then `### Contributors` with the exact verified handles below.

**Example structure:**
```markdown
We're excited to announce the release of **Agent Sandbox {tag}**! Highlights: ...
{pre_release_example}
---

### Highlights

#### Core & Extension Controllers
* **Short feature title (#123):** Concrete description grounded in the diff.

#### SDKs
* **Python SDK:**
  * Concrete change (#124).

---

[Insert exact Installation block here]

--------
### Contributors
We extend our sincere thanks to all contributors to this release:
@handle1, @handle2
```

Exact Installation Block to Insert:
{installation_notes.strip()}

Verified Contributors:
{contributors_str}

Deterministic Release Signals:
{signals_str}

PRs Labeled `release-note-action-required`:
{breaking_changes or "(none)"}

Per-Commit Changes (with file stats, PR descriptions, and filtered code diffs):
{commit_records}
"""


def generate_release_notes(
    commits,
    breaking_changes,
    contributors,
    tag,
    installation_notes,
    release_signals=None,
    model="gemini-4-neon",
):
    """Generates curated release notes using Gemini via the Vertex AI API platform."""
    try:
        from google import genai
        from google.genai import errors
    except ImportError:
        print("❌ Error: 'google-genai' library not installed. Run 'pip install google-genai'.")
        return None

    project_id = os.getenv("GCP_PROJECT", "").strip()
    location = os.getenv("GCP_LOCATION", "global").strip()

    if not project_id:
        print("⚠️ GCP_PROJECT environment variable not set. Skipping Gemini release notes.")
        return None

    prompt = build_prompt(
        enriched_commits=commits,
        breaking_changes=breaking_changes,
        contributors=contributors,
        tag=tag,
        installation_notes=installation_notes,
        release_signals=release_signals,
    )

    try:
        client = genai.Client(
            vertexai=True,
            project=project_id,
            location=location,
        )
        response = client.models.generate_content(
            model=model,
            contents=prompt,
        )
        return strip_markdown_fences(response.text) if response.text else None

    except errors.APIError as e:
        print(f"⚠️ Vertex AI API Error calling Gemini ({e.code}: {e.message}). Skipping release notes.")
        return None
    except Exception as e:
        print(f"⚠️ Unexpected Error calling Vertex AI ({type(e).__name__}: {e}). Skipping release notes.")
        return None


def assemble_release_notes(tag, gemini_notes, installation_notes, contributors, footer):
    """Assembles the final markdown document with deterministic header and footer."""
    parts = [f"# 🚀 Announcing Agent Sandbox {tag}!"]

    if gemini_notes:
        body = gemini_notes.strip()
        # Strip any model-generated trailing sections that are appended
        # deterministically (or intentionally omitted, like What's Changed).
        body = re.sub(
            r"(?ms)\n*^#{2,3}\s+(?:What's Changed|New Contributors)\b.*$",
            "",
            body,
        ).strip()
        body = re.sub(r"(?m)\n*^\*\*Full Changelog\*\*:.*$", "", body).strip()

        if not re.search(r"^#+\s+Installation\b", body, re.MULTILINE | re.IGNORECASE):
            body += "\n\n---\n\n" + installation_notes.strip()
        if contributors and not re.search(
            r"^#+\s+Contributors\b", body, re.MULTILINE | re.IGNORECASE
        ):
            body += (
                "\n\n--------\n### Contributors\n"
                "We extend our sincere thanks to all contributors to this release:\n"
                + ", ".join(contributors)
            )
        parts.append(body)
    else:
        parts.append(installation_notes.strip())
        if contributors:
            parts.append(
                "--------\n### Contributors\n"
                "We extend our sincere thanks to all contributors to this release:\n"
                + ", ".join(contributors)
            )

    if footer:
        parts.append(footer.strip())

    return "\n\n".join(parts) + "\n"


def main():
    parser = argparse.ArgumentParser(description="Generate and preview release notes.")
    parser.add_argument(
        "--tag", required=True, help="The target git tag for the release."
    )
    parser.add_argument(
        "--prev-tag",
        default=None,
        help="Optional previous git tag to compare against (defaults to previous GitHub release).",
    )
    parser.add_argument(
        "--output", default="release_notes_preview.md", help="File to save notes to."
    )
    parser.add_argument(
        "--model",
        default=os.getenv("GEMINI_MODEL", "gemini-4-neon"),
        help="The Gemini model to use.",
    )
    args = parser.parse_args()

    tag = args.tag
    prev_tag = args.prev_tag or get_previous_release_tag(tag)
    print(f"INFO: Found previous tag: {prev_tag}")
    commits = get_commits(prev_tag, tag)

    # Extract PR numbers and fetch details once per PR to minimize API overhead.
    pr_numbers = get_pr_numbers(commits)
    prs_data = fetch_prs_data(pr_numbers)
    contributors = get_contributors(prs_data)
    breaking_changes = get_breaking_changes(prs_data)
    enriched_commits = enrich_commits(commits, prs_data)
    release_signals = collect_release_signals(prev_tag, tag, enriched_commits)
    footer = fetch_github_release_footer(prev_tag, tag)

    installation_notes = f"""### Installation

#### Standard Install (Core + Extensions)
Recommended for most users and GitOps engines (Argo CD, Config Sync, kustomize):
```bash
kubectl apply -f https://github.com/kubernetes-sigs/agent-sandbox/releases/download/{tag}/sandbox-with-extensions.yaml
```

#### Selective Install
Install components separately:
```bash
# Core only:
kubectl apply -f https://github.com/kubernetes-sigs/agent-sandbox/releases/download/{tag}/sandbox.yaml

# Extensions (opt-in):
kubectl apply -f https://github.com/kubernetes-sigs/agent-sandbox/releases/download/{tag}/extensions.yaml
```

#### Python SDK
```bash
pip install k8s-agent-sandbox=={tag.lstrip('v')}
```"""

    if not commits:
        print("INFO: No commits found between tags. Skipping release notes generation.")
        gemini_notes = None
    else:
        gemini_notes = generate_release_notes(
            enriched_commits,
            "\n".join(breaking_changes),
            contributors,
            tag,
            installation_notes,
            release_signals=release_signals,
            model=args.model,
        )
        if not gemini_notes:
            print(
                "⚠️ Warning: Failed to generate release notes using Gemini. Proceeding best-effort.",
                file=sys.stderr,
            )

    combined_content = assemble_release_notes(
        tag=tag,
        gemini_notes=gemini_notes,
        installation_notes=installation_notes,
        contributors=contributors,
        footer=footer,
    )

    print(f"INFO: Saving release notes to {args.output}...")
    with open(args.output, "w") as f:
        f.write(combined_content)
    print("\n--- Preview ---\n")
    print(combined_content)


