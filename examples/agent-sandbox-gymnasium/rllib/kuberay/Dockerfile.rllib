# Build from the repository root. This image is built by the example user, not
# the project's image-discovery/release scripts.
# The pinned image index supports Linux AMD64 and ARM64. Docker selects the
# base for the build's target platform; RAY_BASE_IMAGE can override that base.
ARG RAY_BASE_IMAGE=rayproject/ray:2.58.0-py311-cpu@sha256:5b4128ad47050e80b08a9fac96187e04e7e6dd13abe3f074813818bc86460afe
FROM ${RAY_BASE_IMAGE}

COPY --chown=1000:100 examples/agent-sandbox-gymnasium/rllib/kuberay/requirements.lock /tmp/rllib-requirements.lock
COPY --chown=1000:100 clients/python/agentic-sandbox-client /opt/agent-sandbox/clients/python/agentic-sandbox-client
COPY --chown=1000:100 clients/integrations/gymnasium /opt/agent-sandbox/clients/integrations/gymnasium
# Keep Ray CLI, the dashboard, the driver and actors in the base interpreter.
# Install all application source from this checkout, without needing .git in
# the image. The local version satisfies the integration's SDK dependency.
RUN python -m pip install --no-cache-dir setuptools==80.9.0 setuptools-scm==9.2.2 \
    && SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0+local python -m pip install --no-cache-dir --no-build-isolation \
        -r /tmp/rllib-requirements.lock \
        "/opt/agent-sandbox/clients/python/agentic-sandbox-client[grpc]" \
        /opt/agent-sandbox/clients/integrations/gymnasium \
    && python -m pip check

COPY --chown=1000:100 examples/agent-sandbox-gymnasium/rllib/train.py \
    examples/agent-sandbox-gymnasium/rllib/file_task_env.py \
    examples/agent-sandbox-gymnasium/rllib/verify_sandbox_task.py \
    /opt/agent-sandbox/rllib/
ENV PYTHONPATH=/opt/agent-sandbox/rllib
WORKDIR /opt/agent-sandbox/rllib

RUN python -c "import file_task_env, verify_sandbox_task, torch, ray.rllib; from k8s_agent_sandbox.commands._process_stubs import process_pb2_grpc; import opentelemetry.proto"
