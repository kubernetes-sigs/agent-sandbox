"""Generate namespace-scoped RBAC rule files from the cluster-wide ClusterRoles.

This script is invoked by ``go generate`` (see codegen.go) after controller-gen
has produced the full ClusterRole YAML files.  It reads each ClusterRole,
filters to only the rules needed in watched namespaces (excluding
controller-namespace resources like leases), and writes the result as a bare
YAML rules list that Helm templates can embed via .Files.Get.
"""

import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
REPO_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, "..", ".."))

sys.path.insert(0, os.path.join(SCRIPT_DIR, "shared"))
from rbac_scopes import watched_namespace_rules

HEADER = """\
# AUTO-GENERATED by dev/tools/generate-namespaced-rbac — DO NOT EDIT.
# Source: {source}
# Contains only the WATCHED_NAMESPACE subset of rules for namespace-scoped
# Role resources.  See dev/tools/shared/rbac_scopes.py for the classification.
"""

PAIRS = [
    ("helm/files/rbac.generated.yaml", "helm/files/rbac.namespaced.generated.yaml"),
    ("helm/files/extensions-rbac.generated.yaml", "helm/files/extensions-rbac.namespaced.generated.yaml"),
]


def main():
    for src_rel, dst_rel in PAIRS:
        src = os.path.join(REPO_ROOT, src_rel)
        dst = os.path.join(REPO_ROOT, dst_rel)
        with open(src) as f:
            raw = f.read()
        rules_yaml = watched_namespace_rules(raw)
        with open(dst, "w") as f:
            f.write(HEADER.format(source=src_rel))
            f.write(rules_yaml)
        print(f"generate-namespaced-rbac: {src_rel} -> {dst_rel}")


if __name__ == "__main__":
    main()
