# Install gVisor (runsc) on all nodes of an existing KIND cluster.
#
# Downloads runsc and its containerd shim, copies them into the KIND node
# containers, patches containerd to register the runsc runtime handler,
# restarts containerd, and applies a gvisor RuntimeClass.
#
# Reusable by any CI job that needs gVisor on KIND.
#
# Usage:
#   install-gvisor-kind --cluster-name my-cluster
#   CONTAINER_ENGINE=podman install-gvisor-kind --cluster-name my-cluster

set -euo pipefail

GVISOR_VERSION="${GVISOR_VERSION:-release-20261001.0}"
CONTAINER_ENGINE="${CONTAINER_ENGINE:-docker}"
CLUSTER_NAME=""

usage() {
  echo "Usage: $(basename "$0") --cluster-name <name> [--version <gvisor-release>]"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cluster-name) CLUSTER_NAME="$2"; shift 2 ;;
    --version)      GVISOR_VERSION="$2"; shift 2 ;;
    -h|--help)      usage ;;
    *)              echo "Unknown option: $1" >&2; usage ;;
  esac
done

if [[ -z "${CLUSTER_NAME}" ]]; then
  echo "ERROR: --cluster-name is required" >&2
  usage
fi

ARCH="$(uname -m)"
GVISOR_URL="https://storage.googleapis.com/gvisor/releases/release/${GVISOR_VERSION}/${ARCH}"

TMPDIR="$(mktemp -d)"
cleanup() { rm -rf "${TMPDIR}"; }
trap cleanup EXIT

echo "Installing gVisor ${GVISOR_VERSION} (${ARCH}) on KIND cluster '${CLUSTER_NAME}'"

# Download binaries
echo "Downloading runsc..."
curl -fsSL --retry 3 --retry-connrefused "${GVISOR_URL}/runsc" -o "${TMPDIR}/runsc"
curl -fsSL --retry 3 --retry-connrefused "${GVISOR_URL}/containerd-shim-runsc-v1" -o "${TMPDIR}/containerd-shim-runsc-v1"
chmod +x "${TMPDIR}/runsc" "${TMPDIR}/containerd-shim-runsc-v1"

# Discover KIND node containers
NODE_CONTAINERS=$("${CONTAINER_ENGINE}" ps \
  --filter "label=io.x-k8s.kind.cluster=${CLUSTER_NAME}" \
  --format '{{.Names}}')

if [[ -z "${NODE_CONTAINERS}" ]]; then
  echo "ERROR: no KIND containers found for cluster '${CLUSTER_NAME}'" >&2
  exit 1
fi

echo "Found KIND nodes:"
echo "${NODE_CONTAINERS}" | sed 's/^/  /'

# Install on each node
while IFS= read -r node; do
  echo "Installing gVisor on ${node}..."

  "${CONTAINER_ENGINE}" cp "${TMPDIR}/runsc" "${node}:/usr/local/bin/runsc"
  "${CONTAINER_ENGINE}" cp "${TMPDIR}/containerd-shim-runsc-v1" "${node}:/usr/local/bin/containerd-shim-runsc-v1"

  "${CONTAINER_ENGINE}" exec "${node}" bash -c 'cat >> /etc/containerd/config.toml <<EOF

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
EOF'

  echo "Restarting containerd on ${node}..."
  "${CONTAINER_ENGINE}" exec "${node}" systemctl restart containerd
done <<< "${NODE_CONTAINERS}"

# Wait for nodes to recover after containerd restart
echo "Waiting for nodes to be Ready..."
kubectl wait --for=condition=Ready node --all --timeout=120s

# Apply RuntimeClass
echo "Applying gvisor RuntimeClass..."
kubectl apply -f - <<EOF
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: gvisor
handler: runsc
scheduling:
  nodeSelector:
    kubernetes.io/os: linux
EOF

# Smoke test
echo "Running smoke test..."
kubectl run gvisor-smoke-test \
  --image=busybox:1.36 \
  --restart=Never \
  --overrides='{"spec":{"runtimeClassName":"gvisor"}}' \
  --command -- sleep 30

kubectl wait --for=condition=Ready pod/gvisor-smoke-test --timeout=60s

kernel=$(kubectl exec gvisor-smoke-test -- uname -r 2>/dev/null || echo "unknown")
kubectl delete pod gvisor-smoke-test --ignore-not-found >/dev/null 2>&1 || true

if [[ "${kernel}" == *gvisor* ]]; then
  echo "Smoke test passed: kernel=${kernel}"
else
  echo "ERROR: expected gVisor kernel, got: ${kernel}" >&2
  exit 1
fi

echo "gVisor installation complete on KIND cluster '${CLUSTER_NAME}'"
