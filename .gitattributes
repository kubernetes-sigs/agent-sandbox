# Always check-out / check-in text files with LF line endings, regardless of
# the platform or the clone's core.autocrlf setting. Without this, a Windows
# checkout with the default core.autocrlf=true gets CRLF line endings, which
# make CRLF-sensitive tooling (mdtoc, run by dev/tools/verify-toc) report
# false-positive table-of-contents diffs in the KEP READMEs.
* text=auto eol=lf

# Binary assets are never subject to line-ending normalization.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
