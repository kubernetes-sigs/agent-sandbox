set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "${repo_root}"

# Customizable scale & execution parameters via Environment Variables:
#   TEST_SCENARIO:               continuous-burst | rapid-burst (default: continuous-burst)
#   SIMULATED_NODES:             Number of simulated KWOK nodes (default: 100)
#   CL2_QPS:                     Target claim creation QPS (default: 75)
#   CL2_DURATION_SECONDS:        Duration of load test in seconds (default: 10 -> 750 total claims)
#   CL2_WARMPOOL_SIZE:           Number of pre-warmed sandboxes (default: 1050)
#   CL2_THRESHOLD_50_MS:         Claim adoption latency P50 threshold in ms (default: 300)
#   CL2_THRESHOLD_90_MS:         Claim adoption latency P90 threshold in ms (default: 300)
#   CL2_THRESHOLD_99_MS:         Claim adoption latency P99 threshold in ms (default: 500)
#   CONTROLLER_KUBE_API_QPS:     Controller API QPS (default: 1000)
#   CONTROLLER_KUBE_API_BURST:   Controller API Burst (default: 2000)
#   CONTROLLER_WORKERS:          Sandbox reconciler worker concurrency (default: 50)
#   CONTROLLER_CLAIM_WORKERS:    SandboxClaim reconciler worker concurrency (default: 50)
#   CONTROLLER_MAX_BATCH_SIZE:   WarmPool refill batch size (default: 300)

#   CL2_K8S_CLIENTS_NUMBER:      Number of parallel client-go instances for ClusterLoader2 (default: 20)

SCENARIO="${TEST_SCENARIO:-continuous-burst}"
NUM_NODES="${SIMULATED_NODES:-100}"
QPS="${CL2_QPS:-75}"
DURATION="${CL2_DURATION_SECONDS:-10}"
WARMPOOL="${CL2_WARMPOOL_SIZE:-1050}"
CLIENTS="${CL2_K8S_CLIENTS_NUMBER:-20}"

CONTROLLER_QPS="${CONTROLLER_KUBE_API_QPS:-1000}"
CONTROLLER_BURST="${CONTROLLER_KUBE_API_BURST:-2000}"
CONTROLLER_WORKERS="${CONTROLLER_WORKERS:-50}"
CONTROLLER_CLAIM_WORKERS="${CONTROLLER_CLAIM_WORKERS:-50}"
CONTROLLER_WARM_POOL_WORKERS="${CONTROLLER_WARM_POOL_WORKERS:-1}"
CONTROLLER_TEMPLATE_WORKERS="${CONTROLLER_TEMPLATE_WORKERS:-1}"
CONTROLLER_BATCH="${CONTROLLER_MAX_BATCH_SIZE:-300}"

echo "======================================================="
echo "Executing KWOK Cluster Scalability Presubmit"
echo "  Scenario:          ${SCENARIO}"
echo "  Simulated Nodes:   ${NUM_NODES}"
echo "  WarmPool Size:     ${WARMPOOL}"
echo "  Target QPS:        ${QPS}"
echo "  Burst Duration:    ${DURATION}s"
echo "  Controller QPS:    ${CONTROLLER_QPS} (Workers: ${CONTROLLER_WORKERS})"
echo "======================================================="

CACHE_DIR="${HOME}/.cache/agent-sandbox-test-bin"
mkdir -p "${CACHE_DIR}"
BINDIR="${CACHE_DIR}"
export PATH="${BINDIR}:${PATH}"
WORKDIR="${repo_root}/.build-kwok"
mkdir -p "${WORKDIR}"

KWOK_VERSION="v0.6.0"
KWOKCTL="${BINDIR}/kwokctl"
# Must be a full 40-char SHA: it is fetched directly by hash (see the
# shallow-fetch block below), which GitHub only resolves for full SHAs.
CL2_COMMIT="${CL2_COMMIT:-d14a402a9540e4c8ba34717e428bfd2cf31a41a8}"
CL2_BIN="${BINDIR}/clusterloader2"

if [[ ! -x "${KWOKCTL}" ]]; then
  echo "Installing kwokctl ${KWOK_VERSION}..."
  curl -fsSL --retry 5 --retry-connrefused "https://github.com/kubernetes-sigs/kwok/releases/download/${KWOK_VERSION}/kwokctl-linux-amd64" -o "${KWOKCTL}"
  chmod +x "${KWOKCTL}"
  curl -fsSL --retry 5 --retry-connrefused "https://github.com/kubernetes-sigs/kwok/releases/download/${KWOK_VERSION}/kwok-linux-amd64" -o "${BINDIR}/kwok"
  chmod +x "${BINDIR}/kwok"
fi

if [[ ! -x "${CL2_BIN}" ]]; then
  echo "Building ClusterLoader2 binary (commit ${CL2_COMMIT:0:8})..."
  CL2_TMP_DIR="$(mktemp -d)"
  # Fetch only the pinned commit rather than the full kubernetes/perf-tests
  # history: a full clone pulls the whole monorepo's git history (100+ MiB)
  # on every presubmit run since the CACHE_DIR above does not survive across
  # ephemeral Prow pods, which eats into this job's timeout budget.
  git -C "${CL2_TMP_DIR}" init -q
  git -C "${CL2_TMP_DIR}" remote add origin https://github.com/kubernetes/perf-tests.git
  git -C "${CL2_TMP_DIR}" fetch --quiet --depth 1 origin "${CL2_COMMIT}"
  git -C "${CL2_TMP_DIR}" checkout -q FETCH_HEAD
  (
    cd "${CL2_TMP_DIR}/clusterloader2"
    GOBIN="${BINDIR}" go build -o "${CL2_BIN}" ./cmd/clusterloader.go
  )
  rm -rf "${CL2_TMP_DIR}"
fi

CLUSTER_NAME="kwok-sandbox-scale"

cleanup() {
  echo "Cleaning up controller & simulated cluster..."
  pkill -f "agent-sandbox-controller" 2>/dev/null || true
  if [[ -n "${CONTROLLER_PID:-}" ]]; then
    kill -TERM "${CONTROLLER_PID}" 2>/dev/null || true
    wait "${CONTROLLER_PID}" 2>/dev/null || true
  fi
  if [[ -f "${WORKDIR}/controller.log" && -d "${CL2_REPORT_DIR:-}" ]]; then
    cp "${WORKDIR}/controller.log" "${CL2_REPORT_DIR}/controller.log" 2>/dev/null || true
  fi
  "${KWOKCTL}" delete cluster --name="${CLUSTER_NAME}" 2>/dev/null || true
  rm -rf "${WORKDIR}"
  if [[ -n "${CL2_TMP_DIR:-}" ]]; then
    rm -rf "${CL2_TMP_DIR}"
  fi
  echo "Cleanup complete."
}
trap cleanup EXIT

echo "Ensuring clean start for kwok simulated cluster..."
"${KWOKCTL}" delete cluster --name="${CLUSTER_NAME}" 2>/dev/null || true

"${KWOKCTL}" create cluster --name="${CLUSTER_NAME}" --wait=5m \
  --runtime=binary \
  --disable-qps-limits \
  --extra-args="kube-apiserver=max-requests-inflight=2000" \
  --extra-args="kube-apiserver=max-mutating-requests-inflight=1000" \
  --extra-args="etcd=unsafe-no-fsync=true"

KUBECONFIG="${WORKDIR}/kubeconfig"
"${KWOKCTL}" get kubeconfig --name="${CLUSTER_NAME}" > "${KUBECONFIG}"
export KUBECONFIG

echo "Creating simulated nodes (${NUM_NODES})..."
"${KWOKCTL}" scale node --name="${CLUSTER_NAME}" --replicas="${NUM_NODES}"
kubectl label node node-000000 node-role.kubernetes.io/control-plane="" --overwrite
kubectl patch node node-000000 --subresource=status --type=merge -p '{"status":{"addresses":[{"type":"InternalIP","address":"127.0.0.1"},{"type":"ExternalIP","address":"127.0.0.1"}]}}'

echo "Deploying Agent Sandbox CRDs & System Namespace..."
kubectl create namespace agent-sandbox-system --dry-run=client -o yaml | kubectl apply -f -
kubectl apply -f k8s/crds/

echo "Waiting for CRDs to be established..."
kubectl wait --for=condition=Established crd/sandboxes.agents.x-k8s.io --timeout=1m
kubectl wait --for=condition=Established crd/sandboxclaims.extensions.agents.x-k8s.io --timeout=1m
kubectl wait --for=condition=Established crd/sandboxtemplates.extensions.agents.x-k8s.io --timeout=1m
kubectl wait --for=condition=Established crd/sandboxwarmpools.extensions.agents.x-k8s.io --timeout=1m

echo "Starting Agent Sandbox Controller against simulated cluster..."
pkill -f "agent-sandbox-controller" 2>/dev/null || true
sleep 1
go run ./cmd/agent-sandbox-controller \
  --leader-election-namespace=agent-sandbox-system \
  --extensions=true \
  --metrics-bind-address=":8081" \
  --health-probe-bind-address=":8082" \
  --kube-api-qps="${CONTROLLER_QPS}" \
  --kube-api-burst="${CONTROLLER_BURST}" \
  --sandbox-concurrent-workers="${CONTROLLER_WORKERS}" \
  --sandbox-claim-concurrent-workers="${CONTROLLER_CLAIM_WORKERS}" \
  --sandbox-warm-pool-concurrent-workers="${CONTROLLER_WARM_POOL_WORKERS}" \
  --sandbox-template-concurrent-workers="${CONTROLLER_TEMPLATE_WORKERS}" \
  --sandbox-warm-pool-max-batch-size="${CONTROLLER_BATCH}" > "${WORKDIR}/controller.log" 2>&1 &
CONTROLLER_PID=$!
sleep 3

CL2_REPORT_DIR="${ARTIFACTS:-.}/kwok-cl2-report"
mkdir -p "${CL2_REPORT_DIR}"

TEST_CONFIG="${repo_root}/test/benchmarks/config/agent-sandbox-${SCENARIO}.yaml"
if [[ ! -f "${TEST_CONFIG}" ]]; then
  echo "Error: Scenario configuration ${TEST_CONFIG} not found!"
  exit 1
fi

echo "Running ClusterLoader2 benchmark (Scenario=${SCENARIO}, QPS=${QPS}, Duration=${DURATION}s, WarmPool=${WARMPOOL})..."
# Disable APIAvailability measurement under KWOK simulated clusters:
# APIAvailability deploys an agnhost pod and attempts `kubectl exec` to check API server latency.
# Since KWOK virtual pods do not run a real container runtime or process, `kubectl exec` fails with
# 'no exec found for container agnhost'. Disabling it avoids non-fatal warnings on virtual clusters.
THRESHOLD_50_MS="${CL2_THRESHOLD_50_MS:-300}"
THRESHOLD_90_MS="${CL2_THRESHOLD_90_MS:-300}"
THRESHOLD_99_MS="${CL2_THRESHOLD_99_MS:-500}"
CL2_RC=0
CL2_QPS="${QPS}" \
CL2_DURATION_SECONDS="${DURATION}" \
CL2_WARMPOOL_SIZE="${WARMPOOL}" \
CL2_ENABLE_SCHEDULING_METRICS="false" \
CL2_ENABLE_API_AVAILABILITY="false" \
CL2_POD_STARTUP_LATENCY_THRESHOLD="${CL2_POD_THRESHOLD:-5s}" \
CL2_SANDBOX_CLAIM_CONTROLLER_STARTUP_LATENCY_THRESHOLD_50_MS="${THRESHOLD_50_MS}" \
CL2_SANDBOX_CLAIM_CONTROLLER_STARTUP_LATENCY_THRESHOLD_90_MS="${THRESHOLD_90_MS}" \
CL2_SANDBOX_CLAIM_CONTROLLER_STARTUP_LATENCY_THRESHOLD_99_MS="${THRESHOLD_99_MS}" \
"${BINDIR}/clusterloader2" \
  --testconfig="${TEST_CONFIG}" \
  --kubeconfig="${KUBECONFIG}" \
  --provider=skeleton \
  --enable-exec-service=false \
  --k8s-clients-number="${CLIENTS}" \
  --delete-stale-namespaces=true \
  --v=2 \
  --report-dir="${CL2_REPORT_DIR}" || CL2_RC=$?

echo ""
echo "======================================================="
echo " Scraped Agent Sandbox Controller Metrics (:8081/metrics)"
echo "======================================================="
SCRAPE_RC=0
python3 "${repo_root}/dev/ci/presubmits/shared/scrape_controller_metrics.py" \
  --metrics-url="http://127.0.0.1:8081/metrics" \
  --threshold-50="${THRESHOLD_50_MS}" \
  --threshold-90="${THRESHOLD_90_MS}" \
  --threshold-99="${THRESHOLD_99_MS}" || SCRAPE_RC=$?
echo "======================================================="

if [[ ${CL2_RC} -ne 0 ]]; then
  echo "KWOK cluster benchmark finished with ClusterLoader2 return code ${CL2_RC}."
fi

if [[ ${SCRAPE_RC} -ne 0 ]]; then
  echo "KWOK cluster scalability presubmit FAILED: controller metrics validation failed (latency thresholds violated or metrics unavailable)."
  exit "${SCRAPE_RC}"
fi

if [[ ${CL2_RC} -ne 0 ]]; then
  exit "${CL2_RC}"
fi

echo "KWOK cluster scalability presubmit PASSED successfully."
exit 0

