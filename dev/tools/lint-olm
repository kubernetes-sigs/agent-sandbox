import subprocess
import sys

from shared.utils import get_repo_root


def main():
    repo_root = get_repo_root()
    result = subprocess.run(["make", "-C", "olm", "lint"], cwd=repo_root)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
