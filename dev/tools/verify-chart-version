"""Verifies helm/Chart.yaml is version-bumped when generated chart files change.

The chart embeds content produced by the //go:generate directives in codegen.go
(the CRDs and the controller-gen RBAC rules). Shipping a change to that content
under an unchanged chart version means two different charts exist claiming to be
the same version, which breaks `helm upgrade` and any future OCI publishing.

This compares the working tree against the merge base with the PR's base branch
and fails if the generated chart content changed without the chart version
increasing.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
CHART_PATH = "helm/Chart.yaml"

# Chart content written by codegen.go. Keep in sync with the //go:generate
# directives that target helm/.
GENERATED_CHART_PATHS = [
    "helm/crds/",
    "helm/templates/rbac.generated.yaml",
    "helm/templates/extensions-rbac.generated.yaml",
]

VERSION_RE = re.compile(r"^version:\s*[\"']?(\d+)\.(\d+)\.(\d+)[\"']?\s*$", re.MULTILINE)


def running_in_ci():
    """True when running under GitHub Actions or Prow."""
    return any(
        os.environ.get(name)
        for name in ("CI", "GITHUB_ACTIONS", "PROW_JOB_ID")
    )


def git(args, repo_root, check=True):
    """Runs a git command, returning stdout. Raises CalledProcessError if check."""
    return subprocess.run(
        ["git"] + args,
        cwd=repo_root,
        capture_output=True,
        text=True,
        check=check,
    )


def base_ref():
    """The branch this change is targeting.

    GITHUB_BASE_REF is set by GitHub Actions on pull_request events; Prow sets
    PULL_BASE_REF. Fall back to main for local runs.
    """
    return (
        os.environ.get("GITHUB_BASE_REF")
        or os.environ.get("PULL_BASE_REF")
        or "main"
    )


def resolve_merge_base(repo_root, ref):
    """Finds the merge base with the base branch.

    In Prow presubmits PULL_BASE_SHA is guaranteed to be present locally via
    clonerefs. Outside CI fall back to origin/<ref> (fetching it if missing)
    and then the local branch.
    Returns None if no comparison base can be established.
    """
    pull_base_sha = os.environ.get("PULL_BASE_SHA")
    if pull_base_sha:
        return pull_base_sha

    remote_ref = f"origin/{ref}"

    result = git(["merge-base", "HEAD", remote_ref], repo_root, check=False)
    if result.returncode == 0:
        return result.stdout.strip()

    print(f"INFO: {remote_ref} not present locally; fetching it.")
    fetched = git(
        ["fetch", "--no-tags", "origin", f"{ref}:refs/remotes/origin/{ref}"],
        repo_root,
        check=False,
    )
    if fetched.returncode == 0:
        result = git(["merge-base", "HEAD", remote_ref], repo_root, check=False)
        if result.returncode == 0:
            return result.stdout.strip()

    # A local branch of the same name is enough outside CI.
    result = git(["merge-base", "HEAD", ref], repo_root, check=False)
    if result.returncode == 0:
        return result.stdout.strip()

    return None


def changed_generated_files(repo_root, merge_base):
    """Generated chart files differing from the merge base, including untracked ones."""
    diff = git(
        ["diff", "--name-only", merge_base, "--"] + GENERATED_CHART_PATHS,
        repo_root,
    )
    # git diff does not report untracked files, so a newly generated CRD would
    # otherwise slip through.
    untracked = git(
        ["ls-files", "--others", "--exclude-standard", "--"] + GENERATED_CHART_PATHS,
        repo_root,
    )
    return sorted(
        set(diff.stdout.split()) | set(untracked.stdout.split())
    )


def parse_version(text, source):
    """Extracts (major, minor, patch) from Chart.yaml contents."""
    match = VERSION_RE.search(text)
    if not match:
        print(
            f"ERROR: could not find a 'version: X.Y.Z' line in {source}.",
            file=sys.stderr,
        )
        sys.exit(1)
    return tuple(int(group) for group in match.groups())


def chart_version_at(repo_root, revision):
    """The chart version at a git revision, or None if the chart did not exist."""
    result = git(["show", f"{revision}:{CHART_PATH}"], repo_root, check=False)
    if result.returncode != 0:
        return None
    return parse_version(result.stdout, f"{CHART_PATH} at {revision}")


def format_version(version):
    return ".".join(str(part) for part in version)


def verify(repo_root):
    """Returns a process exit code."""
    chart_file = Path(repo_root) / CHART_PATH
    if not chart_file.exists():
        print(f"ERROR: {CHART_PATH} does not exist.", file=sys.stderr)
        return 1

    ref = base_ref()
    merge_base = resolve_merge_base(repo_root, ref)
    if merge_base is None:
        message = (
            "could not determine a comparison base for the chart version check "
            f"(tried origin/{ref}, fetching it, and the local {ref} branch)"
        )
        if running_in_ci():
            print(f"ERROR: {message}.", file=sys.stderr)
            return 1
        print(f"WARNING: {message}; skipping.")
        return 0

    changed = changed_generated_files(repo_root, merge_base)
    if not changed:
        print("Generated chart content is unchanged; no version bump required.")
        return 0

    # The version must exceed the base branch tip, not just the merge base;
    # otherwise a bump that landed concurrently is duplicated.
    tip = git(["rev-parse", f"origin/{ref}"], repo_root, check=False)
    if tip.returncode != 0:
        # No remote-tracking ref (local runs, or a base branch that only exists
        # locally); a local branch of the same name is the next best tip.
        tip = git(["rev-parse", ref], repo_root, check=False)
    version_revision = tip.stdout.strip() if tip.returncode == 0 else merge_base
    base_version = chart_version_at(repo_root, version_revision)
    if base_version is None:
        print(f"{CHART_PATH} is new in this change; no version bump required.")
        return 0

    head_version = parse_version(chart_file.read_text(), CHART_PATH)

    if head_version > base_version:
        print(
            f"Generated chart content changed and the chart version was bumped "
            f"({format_version(base_version)} -> {format_version(head_version)})."
        )
        return 0

    print(
        f"ERROR: generated chart content changed but the {CHART_PATH} version "
        f"was not increased (still {format_version(head_version)}).",
        file=sys.stderr,
    )
    print("", file=sys.stderr)
    print("Changed generated chart files:", file=sys.stderr)
    for path in changed:
        print(f"  {path}", file=sys.stderr)
    print("", file=sys.stderr)
    print(
        "Run 'dev/tools/bump-chart-version' (or edit the version in "
        f"{CHART_PATH} by hand) and commit the result.",
        file=sys.stderr,
    )
    return 1


def main():
    # Resolve the root from this file rather than the cwd, so the tool always
    # checks its own repo and agrees with bump-chart-version about which chart
    # it is talking about.
    return verify(str(REPO_ROOT))


if __name__ == "__main__":
    sys.exit(main())
