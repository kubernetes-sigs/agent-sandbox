"""Lints the helm chart with chart-testing (ct).

ct runs `helm lint` once per helm/ci/*-values.yaml file, so the conditional
templates are exercised as well as the defaults, and validates Chart.yaml and
values.yaml with yamale and yamllint.

Usage:
    python3 dev/tools/lint-helm
"""

import os
import subprocess
import sys

from shared import utils

# ct shells out to these; they are not Go tools so cannot live in go.mod.
PYTHON_REQUIREMENTS = ["yamllint==1.37.1", "yamale==6.0.0"]


def ensure_venv(tools_dir):
    """Creates a venv with ct's Python dependencies, returning its bin dir."""
    venv_dir = os.path.join(tools_dir, "tmp", "lint-helm-venv")
    bin_dir = os.path.join(venv_dir, "bin")
    if not os.path.exists(os.path.join(bin_dir, "yamale")):
        subprocess.run([sys.executable, "-m", "venv", venv_dir], check=True)
        subprocess.run(
            [os.path.join(bin_dir, "pip"), "install", "--quiet", *PYTHON_REQUIREMENTS],
            check=True,
        )
    return bin_dir


def main():
    repo_root = utils.get_repo_root()
    tools_dir = os.path.join(repo_root, "dev", "tools")

    # ct invokes helm from PATH; use the version pinned in dev/tools/go.mod.
    helm_binary = subprocess.run(
        utils.go_tool_args("-n", "helm"),
        cwd=repo_root, capture_output=True, text=True, check=True,
    ).stdout.strip()

    env = os.environ.copy()
    env["PATH"] = os.pathsep.join(
        [ensure_venv(tools_dir), os.path.dirname(helm_binary), env["PATH"]])

    args = utils.go_tool_args(
        "ct", "lint", "--config", os.path.join(tools_dir, "ct", "ct.yaml"))
    return subprocess.run(args, cwd=repo_root, env=env).returncode


if __name__ == "__main__":
    sys.exit(main())
