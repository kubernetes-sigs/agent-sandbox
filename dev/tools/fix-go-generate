import argparse
import os
import re
import subprocess
import sys

script_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.append(script_dir)

def go_toolchain_env(repo_root, environ):
    """Pins GOTOOLCHAIN to go.mod's toolchain unless the caller already chose one."""
    env = environ.copy()
    if (env.get("GOTOOLCHAIN") or "auto") != "auto":
        return env
    with open(os.path.join(repo_root, "go.mod")) as f:
        match = re.search(r"^toolchain\s+(\S+)\s*$", f.read(), re.MULTILINE)
    if not match:
        sys.exit("go.mod has no toolchain line to build the code generators with")
    # GOTOOLCHAIN=auto never downgrades, so a newer local or CI Go would
    # otherwise build the generators and change their output.
    env["GOTOOLCHAIN"] = match.group(1) + "+auto"
    return env

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--install-only", action="store_true")
    args = parser.parse_args()
    # Find the repo root from the script's location
    repo_root = os.path.abspath(os.path.join(script_dir, '..', '..'))

    # Path to local bin inside the repo
    local_bin = os.path.join(repo_root, "bin")
    os.makedirs(local_bin, exist_ok=True)

    # Tools to install with their exact versions
    tools = [
        ("github.com/bufbuild/buf/cmd/buf@v1.47.2", "buf"),
        ("google.golang.org/protobuf/cmd/protoc-gen-go@v1.33.0", "protoc-gen-go"),
        ("google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0", "protoc-gen-go-grpc"),
    ]

    env = go_toolchain_env(repo_root, os.environ)
    print(f"Using GOTOOLCHAIN={env.get('GOTOOLCHAIN', 'auto')}")

    # Reinstall on every run so the tools are always built by that toolchain.
    print("Installing required code generation tools...")
    # Configure GOBIN to install tools locally into the repo's bin directory
    install_env = env.copy()
    install_env["GOBIN"] = local_bin

    for import_path, binary_name in tools:
        print(f"  Installing {binary_name} ({import_path.split('@')[1]})...")
        # Running go install outside the main module context to avoid modifying go.mod
        subprocess.check_call(["go", "install", import_path], env=install_env, cwd=repo_root)
    print("Tools installed successfully.")

    if args.install_only:
        sys.exit(0)

    # Add local bin to PATH so go generate (and buf generate) can find them
    env["PATH"] = local_bin + os.pathsep + env.get("PATH", "")

    print(f"Running go generate ./... in {repo_root}")
    subprocess.check_call(["go", "generate", "-v", "./..."], cwd=repo_root, env=env)

if __name__ == "__main__":
    main()
