# Periodic kata e2e test: creates a kOps GCE cluster with nested
# virtualization, installs Kata Containers, and runs the RuntimeClass-
# aware e2e tests with SANDBOX_RUNTIME_CLASS=kata-qemu.
#
# Kata cold starts take ~8-12s (30-40x slower than runc), exercising
# the controller under timing conditions that runc and gVisor cannot
# produce. This catches timeout regressions, slowStartBatch issues,
# and reconciliation storms that are invisible with fast runtimes.

set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

export CNI="${CNI:-cilium}"
export STRESS_NODE_COUNT="${STRESS_NODE_COUNT:-3}"
export STRESS_CONTROL_PLANE_SIZE="${STRESS_CONTROL_PLANE_SIZE:-n2-standard-4}"
export SANDBOX_RUNTIME_CLASS="${SANDBOX_RUNTIME_CLASS:-kata-qemu}"
export SANDBOX_POOL_SIZES="${SANDBOX_POOL_SIZES:-8}"
export SANDBOX_BATCH_CAP="${SANDBOX_BATCH_CAP:-2}"

exec "${REPO_ROOT}/test/benchmarks/scenarios/benchmarks-kops-gcp-kata/run"
